# API Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=your_session_secret

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json
# Or use a path to the service account key file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-firebase-bucket.appspot.com

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=AI Wave Rider <noreply@aiwaverider.com>
SUPPORT_EMAIL=support@aiwaverider.com
WEBSITE_URL=https://aiwaverider.com

# Payment Gateways
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Google Pay
GOOGLE_MERCHANT_ID=your_google_merchant_id

# Apple Pay
APPLE_MERCHANT_ID=merchant.com.yourcompany.app

# Notifications
ENABLE_NOTIFICATIONS=true
# Set to 'false' to disable all notifications

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000 

VITE_BIC_API_URL=https://api.iban.com/clients/api/swiftv2/bank/
VITE_BIC_API_KEY=your_api_key_here
